# =================================================================
# Expected chain configuration (CHECKLIST: Network/Chain ID Mismatch)
# =================================================================
# EIP-155 chain id where the KlerosEscrowFactory is deployed. The ChainGuard
# banner + useIsOnExpectedChain() helper surface a "Switch to {{chain}}"
# CTA when the wallet is on any other network — without this every
# writeContractAsync() against the factory silently reverts with no
# useful copy (worst-case checklist item).
#
# 1       = Ethereum mainnet
# 11155111 = Sepolia (default dev)
# Leave unset to disable the chain guard (dev only).
VITE_EXPECTED_CHAIN_ID=11155111

