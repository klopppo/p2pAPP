VITE_SUPABASE_URL=https://tauyciaavhnopeseecmz.supabase.co/

# Legacy JWT anon key — still works, but the publishable key below is the
# recommended format for new projects. The client prefers VITE_SUPABASE_PUBLISHABLE_KEY
# when present, and falls back to this one.
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InRhdXljaWFhdmhub3Blc2VlY216Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODIxNTM0NTAsImV4cCI6MjA5NzcyOTQ1MH0.b0xcZAWd8Jcqat-6TDbWACEwUuatS2H-XMGgS9TBCXk

# New Supabase publishable key (drop-in replacement for the anon key).
# Safe to ship to the browser. Get it from
# https://app.supabase.com/project/YOUR_PROJECT/settings/api → "Publishable key".
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_c-cohNWs9a1h0EMw6V1Wgg_bWHeEcGl

# Supabase service role key (for server-side operations - NEVER expose this!)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# =================================================================
# Resend (email provider) — for the `send-email` Edge Function.
# NEVER commit a real key here. Put it in .env.local (gitignored)
# and mirror it into Supabase secrets:
#   supabase secrets set RESEND_API_KEY=... EMAIL_FROM=...
# Get an API key at https://resend.com/api-keys
# =================================================================
RESEND_API_KEY=
EMAIL_FROM="P2P Escrow <onresend.dev>"

# =================================================================
# Optional: Custom Domain for Magic Link
# =================================================================
VITE_APP_URL=http://localhost:5173/


#'tauyciaavhnopeseecmz'
#NEXT_PUBLIC_SUPABASE_URL=
# =================================================================
# WalletConnect Configuration (REQUIRED for "Connect Wallet" to work)
# =================================================================
# Create a free project at https://cloud.walletconnect.com and paste its
# Project ID here. Without a valid id, WalletConnect pairing (mobile wallets,
# QR codes, and WC-based injected flows) fails in ALL browsers.
# Project ids are safe to expose in client bundles — they are public by design.
VITE_WC_PROJECT_ID=

# =================================================================
# Chain + deployed contracts (Sepolia, deployed 2026-09-09)
# =================================================================
# EIP-155 chain id the UI targets. See wagmi.ts for the supported list.
# 1       = Ethereum mainnet
# 11155111 = Sepolia
VITE_EXPECTED_CHAIN_ID=11155111

# KlerosEscrowFactory address — every escrow the UI creates is a clone of
# the implementation pinned inside this factory.
VITE_KLEROS_ESCROW_FACTORY=0x8F747eCa387Fae1e6c9f997be7e1abe50d667f1C

# Trade token address — the ERC-20 the escrows hold and release. The factory
# constructor pins this as the immutable `token` slot.
VITE_KLEROS_ESCROW_TOKEN=0x8026BDb39c4BF99FEeb840fe4a450a19cbEaa9F2
